# =============================================================================
# Frontend (LibreChat) — paths scoped under /frontend
# =============================================================================

# Logs / local data dirs
/frontend/data-node
/frontend/meili_data*
/frontend/data/
/frontend/logs
/frontend/uploads/
/frontend/images
/frontend/release/

# Runtime
/frontend/pids
/frontend/*.pid
/frontend/*.seed

# CI / redis dump
/frontend/test-image*
/frontend/dump.rdb

# Translations
/frontend/config/translations/stores/*
/frontend/client/src/localization/languages/*_missing_keys.json

# Compiled / public build artifacts
/frontend/public/main.js
/frontend/public/main.js.map
/frontend/public/main.js.LICENSE.txt
/frontend/client/public/images/
/frontend/client/public/main.js
/frontend/client/public/main.js.map
/frontend/client/public/main.js.LICENSE.txt

# Azure Blob Storage Emulator (Azurite)
/frontend/__azurite**
/frontend/__blobstorage__/**/*

# Nested node_modules (also covered by global node_modules/)
/frontend/api/node_modules/
/frontend/client/node_modules/

# Config (do not commit local LibreChat config)
/frontend/librechat.yaml
/frontend/librechat.yml
/frontend/.npmrc
/frontend/cache.json
/frontend/api/data/
/frontend/owner.yml
/frontend/archive
/frontend/src/style - official.css
/frontend/config.local.ts
/frontend/auth.json
/frontend/junit.xml
/frontend/**/storageState.json

# E2E / Playwright
/frontend/e2e/specs/.test-results/
/frontend/e2e/.generated/
/frontend/e2e/playwright-report/
/frontend/playwright/.cache/
/frontend/.playwright-mcp/*

# Docker override (local)
/frontend/docker-compose.override.yaml
/frontend/docker-compose.override.yml

# Meilisearch
/frontend/meilisearch
/frontend/meilisearch.exe
/frontend/data.ms/*

# Packages / images
/frontend/packages/ux-shared/

# Keep this Data settings tab (un-ignore under frontend/data ignore)
!/frontend/client/src/components/Nav/SettingsTabs/Data/

# Helm
/frontend/helm/librechat/Chart.lock
/frontend/helm/**/charts/
/frontend/helm/**/.values.yaml

# Type stubs we do commit
!/frontend/client/src/@types/i18next.d.ts
!/frontend/client/src/@types/react.d.ts
!/frontend/**/vite-env.d.ts

