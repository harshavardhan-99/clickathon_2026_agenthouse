# Copy to .env and fill in. Never commit .env.

# --- Postgres (metadata registry) ---
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@HOST:5432/postgres

# --- ClickHouse Cloud (event facts) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# --- Feature specs (SPECS_ROOT/{feature_id}/spec.md + events.ndjson) ---
SPECS_ROOT=/path/to/Atlys/specs

# --- Models / Agno (Gemini Developer API) ---
# Create a key at https://aistudio.google.com/apikey
# Note: some "AQ." auth keys currently return 401 ACCESS_TOKEN_TYPE_UNSUPPORTED
# against generativelanguage.googleapis.com — if that happens, regenerate the key
# or use a project/key that the Generative Language API accepts.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
