# Copy to .env and fill in. Never commit .env.

# --- Postgres (metadata registry + optional Agno sessions) ---
# Use a real hostname for HOST (not the password). Port 5432.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@HOST:5432/postgres
SESSION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@HOST:5432/postgres

# --- ClickHouse Cloud (event facts) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# --- Feature specs (SPECS_ROOT/{feature_id}/spec.md + events.ndjson) ---
SPECS_ROOT=./specs

# --- Models / Agno ---
OPENAI_API_KEY=

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
AGENT_OS_HOST=0.0.0.0
AGENT_OS_PORT=8000
