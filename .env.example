# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=atlys
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CONNECT_TIMEOUT=30
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=60
CLICKHOUSE_MCP_COMMAND=python -m mcp_clickhouse.main
CLICKHOUSE_MCP_TIMEOUT_SECONDS=90

# Model — provider: claude | gemini | openai
MODEL_PROVIDER=claude
MODEL_ID=claude-sonnet-4-6
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Langfuse
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Optional Postgres
DATABASE_URL=
SESSION_DATABASE_URL=

# AgentOS
AGENTOS_ID=clickathon-visualization
AGENTOS_DESCRIPTION=NL → ClickHouse MCP → AnalyticsResponse blocks
AGENTOS_HOST=0.0.0.0
AGENTOS_PORT=7777
AGENTOS_DB_PATH=tmp/visualization_agent_os.db
AGENT_ID=visualization-agent
AGENT_NAME=Visualization Agent
AGENT_HISTORY_RUNS=3
