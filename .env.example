# Copy to .env and fill in. Never commit .env.

# --- Postgres (metadata registry + optional Agno sessions) ---
# Use a real hostname for HOST (not the password). Port 5432.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@HOST:5432/postgres
SESSION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@HOST:5432/postgres

# --- ClickHouse Cloud (event facts) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=atlys
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CONNECT_TIMEOUT=30
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=60
CLICKHOUSE_MCP_COMMAND=python -m mcp_clickhouse.main
CLICKHOUSE_MCP_TIMEOUT_SECONDS=90

# --- Feature specs (SPECS_ROOT/{feature_id}/spec.md + events.ndjson) ---
SPECS_ROOT=./specs

# --- Model — provider: claude | gemini | openai ---
MODEL_PROVIDER=claude
MODEL_ID=claude-sonnet-4-6
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Langfuse
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Same Langfuse project as LibreChat; filter traces by environment
LANGFUSE_TRACING_ENVIRONMENT=agno-dev
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Shared FastAPI host (instrumentation / context) ---
AGENT_OS_HOST=0.0.0.0
AGENT_OS_PORT=8000

# --- Conversation / visualization AgentOS ---
AGENTOS_ID=clickathon-visualization
AGENTOS_DESCRIPTION=NL → ClickHouse MCP → AnalyticsResponse blocks
AGENTOS_HOST=0.0.0.0
AGENTOS_PORT=7777
AGENTOS_DB_PATH=tmp/visualization_agent_os.db
AGENT_ID=visualization-agent
AGENT_NAME=Visualization Agent
AGENT_HISTORY_RUNS=3
